# ==============================================================================
# AeroCool-AI: Environment Configuration Template
# ==============================================================================

# Application Environment
AEROCOOL_ENV=development
AEROCOOL_DEBUG=true
AEROCOOL_APP_HOST=0.0.0.0
AEROCOOL_APP_PORT=8000
AEROCOOL_API_PREFIX=/api/v1
AEROCOOL_SECRET_KEY=change-this-super-secret-key-in-production

# PostgreSQL + PostGIS Configuration
POSTGRES_USER=aerocool
POSTGRES_PASSWORD=aerocool_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aerocool_db
DATABASE_URL=postgresql+asyncpg://aerocool:aerocool_secure_pass@localhost:5432/aerocool_db

# Redis Caching & Message Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Google Earth Engine (GEE) Authentication
# Option 1: Service Account Credentials (Preferred for Server/Production)
GEE_SERVICE_ACCOUNT=your-gee-service-account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_FILE=
# Option 2: Cloud Project ID for standard OAuth authentication
GEE_PROJECT_ID=your-gee-cloud-project-id

# NASA Earthdata / LP DAAC (For ECOSTRESS Diurnal LST)
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password
EARTHDATA_BEARER_TOKEN=

# ECMWF / Copernicus Climate Data Store (CDS API for ERA5-Land Reanalysis)
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
CDS_API_KEY=your-cds-api-key

# OpenStreetMap / Overpass API Endpoint
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# ML / Physics Model Default Configuration
MODEL_DEVICE=cuda
MODEL_CHECKPOINT_DIR=./checkpoints
DATA_CACHE_DIR=./data_cache
BATCH_SIZE=64
SEB_LOSS_WEIGHT=0.35
PDE_LOSS_WEIGHT=0.25
DATA_LOSS_WEIGHT=0.40
